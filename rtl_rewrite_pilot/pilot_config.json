{
  "schema_version": "rtltrial.pilot_config.v1",
  "note": "Shared, frozen-at-baseline settings. Changing anything here after a baseline requires a new manifest (validate will refuse a mismatch).",
  "tools": {
    "yosys_bin": "yosys",
    "sta_bin": "sta",
    "iverilog_bin": "iverilog",
    "vvp_bin": "vvp",
    "verilator_bin": "verilator"
  },
  "synthesis": {
    "target": "sky130hd tt_025C_1v80",
    "liberty": "${ORFS_PLATFORMS:-/opt/OpenROAD-flow-scripts/flow/platforms}/sky130hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib",
    "liberty_sha256": "ec0e1067a35c8bf20b11e58d1e8ac53326067e4dac84a125cc1b917a3518d0d9",
    "area_unit": "Liberty area units as reported by Yosys stat -liberty (sky130hd library declares no explicit unit; not assumed to be um^2)",
    "abc_delay_ps": 10000,
    "sta_paths": 5,
    "timeout_s": 600,
    "repeat_runs": 3,
    "sdc": {
      "period_ns": 10.0,
      "provenance": "pilot-authored; designs ship no SDC",
      "known_gaps": [
        "clock period chosen by the pilot, not by the design owner",
        "zero input/output delays; no driving cell or output load",
        "no wire load model and no parasitics"
      ]
    }
  },
  "tb": {"compile_timeout_s": 120},
  "budget": {"max_attempts_per_arm": 3, "max_rounds": 2, "candidates_per_round": [2, 1]},
  "acceptance_rule": {
    "primary_metric": "area",
    "min_rel_area_improvement": 0.005,
    "timing_used_for_decision": false,
    "require_original_tb": "TB_PASSED",
    "require_equal_coarse_ff_bits": true,
    "require_no_new_latches": true,
    "require_no_new_lint_warnings": true,
    "require_no_new_synth_warnings": true,
    "suspicious_rel_area_drop": 0.25,
    "note": "Frozen before any candidate is evaluated. A candidate whose fingerprint equals its parent's is COLLAPSED regardless of area."
  },
  "llm": {
    "api_key_env": "LLM_API_KEY",
    "model_env": "LLM_MODEL",
    "base_url_env": "LLM_BASE_URL",
    "temperature": 0.2,
    "max_output_tokens": 4096,
    "max_input_chars": 24000,
    "request_timeout_s": 180
  }
}
