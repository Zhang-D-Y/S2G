# rtltrial frozen synthesis flow v1 -- sky130hd tt_025C_1v80
# The rendered script is hashed into every synth run's job key.
${read_cmds}
hierarchy -check -top ${top}
synth -top ${top} -flatten -run begin:fine
tee -q -o coarse_stat.txt stat -width
write_json coarse.json
synth -top ${top} -flatten -run fine:
dfflibmap -liberty ${liberty} ${dont_use}
abc -D ${abc_delay_ps} -liberty ${liberty} ${dont_use}
hilomap -singleton -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
opt_clean -purge
# give cells stable public names so netlist.v, mapped.json and STA reports agree
rename -enumerate -pattern _c%_ t:*
tee -q -o stat.json stat -json -liberty ${liberty}
tee -q -o stat.txt stat -liberty ${liberty}
write_verilog -noattr -noexpr netlist.v
write_json mapped.json
read_liberty -lib ${liberty}
tee -q -o check.txt check
